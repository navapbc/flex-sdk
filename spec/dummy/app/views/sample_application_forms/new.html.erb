<%= strata_form_with(model: @sample_application_form) do |f| %>
  <h1 class="margin-top-0"><%= t(".title") %></h1>
  <%= render Strata::US::ButtonGroupComponent.new do |group| %>
    <% group.with_item do %>
      <%= link_to(
        t("actions.back"),
        sample_application_forms_path,
        class: Strata::US::ButtonComponent.css_classes(variant: :outline)
      ) %>
    <% end %>
    <% group.with_item do %>
      <%= f.submit t(".agree_button") %>
    <% end %>
  <% end %>
<% end %>
 