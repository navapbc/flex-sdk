<%# locals: (back_path:, f:) %>

<hr class="border-base-lightest margin-top-4">

<%= render Strata::US::ButtonGroupComponent.new do |group| %>
  <% group.with_item do %>
    <%= strata_link_to t("actions.back"), back_path, as: :button, variant: :outline %>
  <% end %>
  <% group.with_item do %>
    <%= f.submit t("actions.save_and_continue") %>
  <% end %>
<% end %>