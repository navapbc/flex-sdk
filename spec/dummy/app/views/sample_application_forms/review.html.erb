<% if @sample_application_form.submitted? %>
<div class="margin-bottom-4">
<%= link_to sample_application_form_path(@sample_application_form), class: "usa-link" do %>
  <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
    <use href="<%= asset_path("@uswds/uswds/dist/img/sprite.svg#arrow_back") %>"></use>
  </svg>
  <%= t("actions.back") %>
<% end %>
<% end %>
</div>

<div class="grid-col-12">
  <h1><%= t(".title.#{@sample_application_form.submitted? ? "submitted" : "unsubmitted"}") %></h1>
  <% unless @sample_application_form.submitted? %>
  <p><%= t(".description") %></p>
  <% end %>

  <div class="margin-top-4">
    <div class="border-top border-base-light padding-top-2 margin-top-2">
              <div class="padding-bottom-2 border-bottom border-base-light">
          <h3 class="font-sans-md"><%= t(".name") %></h3>
          <p class="margin-top-1"><%= @sample_application_form.applicant_name_first || "-" %></p>
        </div>
              <div class="padding-top-2 padding-bottom-2 border-bottom border-base-light">
        <h3 class="font-sans-md"><%= t(".date_of_birth") %></h3>
        <p class="margin-top-1">
          <% if @sample_application_form.date_of_birth.present? %>
            <%= @sample_application_form.date_of_birth.strftime(t("formats.date.full")) %>
          <% else %>
            -
          <% end %>
        </p>
      </div>
                <div class="padding-bottom-2 border-bottom border-base-light">
          <h3 class="font-sans-md"><%= t(".employer_name") %></h3>
          <p class="margin-top-1"><%= @sample_application_form.employer_name || "-" %></p>
        </div>
                <div class="padding-bottom-2 border-bottom border-base-light">
          <h3 class="font-sans-md"><%= t(".leave_type") %></h3>
          <p class="margin-top-1"><%= @sample_application_form.leave_type || "-" %></p>
        </div>
    </div>
  </div>

  <% if @sample_application_form.submitted? %>
    <%= strata_link_to "Back", sample_application_form_path(@sample_application_form), as: :button, variant: :outline, class: "margin-top-4" %>
  <% else %>
    <%= form_with url: submit_sample_application_form_path(@sample_application_form), method: :patch, local: true do |f| %>
      <%= render Strata::US::ButtonGroupComponent.new(classes: "margin-top-4") do |group| %>
        <% group.with_item do %>
          <%= strata_link_to "Back", sample_application_form_path(@sample_application_form), as: :button, variant: :outline %>
        <% end %>
        <% group.with_item do %>
          <%= f.submit t(".submit_application"), class: Strata::US::ButtonComponent.css_classes %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

