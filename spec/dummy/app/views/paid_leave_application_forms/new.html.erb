<%= strata_form_with(model: @paid_leave_application_form) do |f| %>
  <h1 class="margin-top-0"><%= t(".title") %></h1>
  <ol class="usa-process-list margin-left-05 margin-top-2">
    <li class="usa-process-list__item">
      <h2 class="usa-process-list__heading"><%= t(".prepare_for_your_application_title") %></h3>
      <p><%= t(".prepare_for_your_application_body") %></p>
    <li>
    <li class="usa-process-list__item">
      <h2 class="usa-process-list__heading"><%= t(".complete_your_application_title") %></h3>
      <p><%= t(".complete_your_application_body_html") %></p>
    <li>
      <li class="usa-process-list__item">
      <h2 class="usa-process-list__heading"><%= t(".receive_a_decision_title") %></h3>
      <p><%= t(".receive_a_decision_body") %></p>
    <li>
  </ol>
  <hr class="border-base-lightest margin-top-4">
  <ul class="usa-button-group">
    <li>
      <%= link_to(
        t("actions.back"),
        paid_leave_application_forms_path,
        class: "usa-button usa-button--outline"
      ) %>
    </li>
    <li>
      <%= f.submit t(".agree_button"), class: "usa-button" %>
    </li>
  </ul>
<% end %>
 