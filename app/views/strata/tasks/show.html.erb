<%# Backwards-compatible wrapper around Strata::Tasks::ShowComponent.
    Existing call sites using `render template: 'strata/tasks/show', locals: {...}`
    continue to work. New code should prefer `render Strata::Tasks::ShowComponent.new(...)`.

    Required locals:
    - task: Strata::Task - The task object

    Optional locals:
    - assigned_user_display_text: String - Name of the assignee. Only used when the
      default task_info row is rendered (i.e. no task_info: local or
      content_for(:task_info) is provided).
    - task_details_partial: String - Partial path to render for the task details. If not
      provided, the view looks for a partial named after the task type within `details/`.
    - task_info: Array - An array of {label:, value:} hashes.
    - breadcrumbs: Array - Array of {text:, link:} hashes overriding the default trail.

    Legacy content_for overrides:
    - :task_details_partial - forwarded explicitly via the slot below.
    - :breadcrumbs / :task_info - still respected, handled by the inner
      `strata/shared/_breadcrumbs` and `strata/tasks/_task_info` partials'
      own `content_for?` checks. No wrapper-level forwarding is needed.
%>
<%
  _known_locals = %i[task assigned_user_display_text task_info breadcrumbs task_details_partial]
  _details_locals = local_assigns.to_h.except(*_known_locals)
%>
<%= render Strata::Tasks::ShowComponent.new(
      task: task,
      assigned_user_display_text: local_assigns[:assigned_user_display_text],
      task_info: local_assigns[:task_info],
      breadcrumbs: local_assigns[:breadcrumbs],
      task_details_partial: local_assigns[:task_details_partial],
      details_locals: _details_locals
    ) do |c| %>
  <% c.with_task_details_content  { content_for(:task_details_partial) } if content_for?(:task_details_partial) %>
<% end %>
