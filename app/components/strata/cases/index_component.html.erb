<h1 class="usa-heading-xl margin-bottom-6"><%= @title %></h1>

<% needs_review_count = action_name == "index" ? @cases.count : @model_class.actionable.count %>
<% tabs = [
  { name: "Needs Review", path: polymorphic_path(@model_class), active: action_name == "index", count: needs_review_count },
  { name: "Past Applications", path: polymorphic_path(@model_class, action: "closed"), active: action_name == "closed" }
] %>

<nav class="display-flex margin-bottom-2">
  <% tabs.each_with_index do |tab, index| %>
    <%= render partial: "strata/cases/nav_tab", locals: tab.merge(first: index == 0, last: index == tabs.size - 1) %>
  <% end %>
</nav>

<%= render Strata::US::TableComponent.new(borderless: true, classes: "width-full") do |table| %>
  <% @case_row_component_class.headers.each do |header| %>
    <% table.with_header(classes: "bg-base-lightest") { header } %>
  <% end %>

  <% if @cases.any? %>
    <% @cases.each do |kase| %>
      <% table.with_row do %>
        <%= render @case_row_component_class.new(kase:) %>
      <% end %>
    <% end %>
  <% else %>
    <% table.with_row do %>
      <td colspan="<%= @case_row_component_class.columns.count %>" class="text-center">No cases</td>
    <% end %>
  <% end %>
<% end %>
