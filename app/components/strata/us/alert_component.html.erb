<div class="<%= wrapper_classes %>" <%= tag.attributes(@html_attributes) %>>
  <div class="usa-alert__body">
    <% if heading? %>
      <%= content_tag @heading_tag, heading, class: "usa-alert__heading" %>
    <% end %>
    <% if body? %>
      <p class="usa-alert__text"><%= body %></p>
    <% end %>
  </div>
</div>
