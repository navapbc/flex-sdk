<%= content_tag @tag, class: card_classes, **@html_attributes do %>
  <div class="usa-card__container">
    <% if header? %>
      <header class="usa-card__header">
        <%= content_tag @heading_tag, header, class: "usa-card__heading" %>
      </header>
    <% end %>
    <% if media? %>
      <div class="<%= media_classes %>">
        <div class="usa-card__img">
          <%= media %>
        </div>
      </div>
    <% end %>
    <% if body? %>
      <div class="usa-card__body">
        <%= body %>
      </div>
    <% end %>
    <% if footer? %>
      <div class="usa-card__footer">
        <%= footer %>
      </div>
    <% end %>
  </div>
<% end %>
